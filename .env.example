# Copy to .env.local (development) or .env (production) and fill in.
# Never commit real keys: .env* files are git-ignored.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (required) ──────────────────────────────────────────────
# Dashboard → Project Settings → API. The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Market data (optional: demo prices are used while empty) ─────────
# Finnhub (https://finnhub.io/dashboard): quotes, news, search, profiles
FINNHUB_API_KEY=
# Alpaca (https://app.alpaca.markets → Paper account → API keys): chart bars + live prices
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ── Stripe, TEST MODE (optional until you sell) ──────────────────────
# Use sk_test_ keys. Create a "Facet Pro" product with a $20/month price (and optionally $192/year).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Only at launch, together with live keys:
# FACET_ALLOW_LIVE_STRIPE=true

# ── Email via Resend (optional: alert and challenge emails) ──────────
RESEND_API_KEY=
EMAIL_FROM=Facet <alerts@yourdomain.com>

# ── Engine ───────────────────────────────────────────────────────────
# Protects /api/cron/tick. Use a long random string.
CRON_SECRET=
WORKER_INTERVAL_MS=20000
# Fill orders outside US market hours. Handy while developing; set to false in production.
FACET_ALLOW_EXTENDED_FILLS=true
